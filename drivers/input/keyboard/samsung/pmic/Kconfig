config KEYBOARD_SAMSUNG_PMIC
	depends on I2C
	tristate "Samsung Electronics PMIC Powerkey/Vol-down Controller"

config KEYBOARD_S2MPS25
	tristate "Samsung Electronics S2MPS25 Powerkey/Vol-down Controller"
	depends on I2C
	depends on MFD_S2MPS25

config KEYBOARD_S2MPS27
	tristate "Samsung Electronics S2MPS27 Powerkey/Vol-down Controller"
	depends on I2C
	depends on MFD_S2MPS27

config KEYBOARD_S2MPU15_8845
	tristate "Samsung Electronics S2MPU15 Powerkey/Vol-down Controller for s5e8845"
	depends on I2C
	depends on MFD_S2MPU15_8845
