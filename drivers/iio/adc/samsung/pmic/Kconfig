# SAMSUNG PMIC ADC drivers
#
# When adding new entries keep the list in alphabetical order

config ADC_SAMSUNG_PMIC
	tristate "SAMSUNG PMIC  ADC driver support"
	depends on I2C
	help
	  Core support for the ADC block found in the Samsung PMIC series
	  for drivers such as the touchscreen and hwmon to use to share
	  this resource.

	  To compile this driver as a module, choose M here: the module will be
	  called exynos_adc.

config S2MPS25_ADC
	tristate "S2MPS25 ADC driver support"
	depends on MFD_S2MPS25
	help
	  Core support for the ADC block found in the Samsung PMIC series
	  for drivers such as the touchscreen and hwmon to use to share
	  this resource.

	  To compile this driver as a module, choose M here: the module will be
	  called exynos_adc.

config S2MPU15_ADC_8845
	tristate "S2MPU15 ADC driver support for 8845"
	depends on MFD_S2MPU15_8845
	help
	  Core support for the ADC block found in the Samsung PMIC series
	  for drivers such as the touchscreen and hwmon to use to share
	  this resource.

	  To compile this driver as a module, choose M here: the module will be
	  called exynos_adc.
